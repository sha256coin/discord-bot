# Existing
DISCORD_TOKEN=
GUILD_ID=
EXPLORER_API=
CHANNEL_ID=
MESSAGE_ID=

# Node RPC (pool server, localhost only)
RPC_URL=http://127.0.0.1:25332
RPC_USER=
RPC_PASS=

# Alert channels. Leave one empty and its alerts are only logged.
# ALERT_CHANNEL_ID: reorgs, competing branches, stalled chain (community)
# ADMIN_CHANNEL_ID: node unreachable, few peers (operators)
ALERT_CHANNEL_ID=
ADMIN_CHANNEL_ID=

# Thresholds (defaults shown)
# STALL_HOURS=3
# REORG_ALERT_DEPTH=3
# BRANCH_ALERT_LEN=3
# BRANCH_MAX_AGE_BLOCKS=100
# MIN_PEERS=3
# RPC_FAILURES_BEFORE_ALERT=2
